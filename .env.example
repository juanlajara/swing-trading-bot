ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_LIVE must never be set to true until Carlos gives explicit go/no-go after Phase 3
ALPACA_LIVE=false
# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here
# On Railway: set this to /data/trades.db and mount a Volume at /data
DB_PATH=/data/trades.db
